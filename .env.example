# 使用 `openssl rand -hex 32` 生成并替换。不要提交真实值。
SYNC_TOKEN=replace-with-64-hex-characters

# 只绑定本机，由 HTTPS 反向代理访问。
SYNC_LISTEN=127.0.0.1:8080
SYNC_DATA_DIR=./data
SYNC_MAX_BODY_BYTES=2097152

# 可选：为 RSS 摘要与任务规划启用 OpenAI 兼容模型。密钥只保存在服务器。
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
GOMEMLIMIT=48MiB
