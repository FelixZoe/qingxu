# 必须替换为 `openssl rand -hex 32` 生成的 64 个十六进制字符。
# 这个公开占位值会被服务拒绝；同一个真实值填入清序各端。
SYNC_TOKEN=replace-with-a-long-random-token

# Web 端域名；多个来源用英文逗号分隔。只用 iOS/Windows 时可留空。
SYNC_CORS_ORIGINS=https://todo.darker.one

# 仅让本机反向代理访问同步服务。
SYNC_LISTEN=127.0.0.1:8080
# 生产服务器建议改为 release 目录之外的绝对路径，例如 /opt/qingxu/sync/data。
SYNC_DATA_DIR=./data
SYNC_MAX_BODY_BYTES=2097152
SYNC_HEALTH_URL=http://127.0.0.1:8080/health
GOMEMLIMIT=48MiB

# 可选：启用 RSS 摘要和任务智能安排；兼容 OpenAI Chat Completions 的服务均可。
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
